{
  "name": "@agentpay/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AgentPay Passport backend — Fastify HTTP service (auth, marketplace, tasks).",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/jwt": "^10.0.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.36.4",
    "fastify": "^5.6.1",
    "postgres": "^3.4.5",
    "siwe": "^3.0.0",
    "viem": "^2.21.55",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "bullmq": "^5.34.5",
    "ioredis": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^4.1.6",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}

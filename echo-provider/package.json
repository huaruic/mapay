{
  "name": "@agentpay/echo-provider",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Reference AgentPay provider service. Wraps a trivial echo handler with the verify-and-consume middleware to demonstrate the protocol end-to-end.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentpay/provider-middleware": "file:../provider-sdk",
    "fastify": "^5.6.1",
    "viem": "^2.21.55"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}

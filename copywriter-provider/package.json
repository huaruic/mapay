{
  "name": "@agentpay/copywriter-provider",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "AgentPay provider tool that uses DeepSeek to generate marketing tweets (zh/en, <140 chars). Wraps DeepSeek chat completions behind the AgentPay receipt-gated middleware.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@agentpay/provider-middleware": "file:../provider-sdk",
    "fastify": "^5.6.1",
    "viem": "^2.21.55",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=22"
  }
}
